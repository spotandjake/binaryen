{
  "name": "esy-binaryen",
  "version": "129.0.0",
  "description": "Esy binaryen build",
  "esy": {
    "buildsInSource": true,
    "build": [
      "cmake -G Ninja . -B build -DBUILD_STATIC_LIB=ON -DBUILD_TESTS=OFF -DBUILD_TOOLS=ON -DCMAKE_BUILD_TYPE=Release",
      "ninja -C build"
    ],
    "install": ["cp -r #{self.target_dir / 'build' / 'bin/'} #{self.bin}"]
  },
  "dependencies": {
    "@opam/conf-cmake": "grain-lang/cmake:esy.json#033cab656dc71a6488b3c1ca6ea45099f794bd03",
    "@opam/conf-ninja": "spotandjake/ninja:esy.json#25fe64432492abd515bd4a53f6c7b4fd1a5d9315"
  }
}